# Copy to .env (git-ignored) and uncomment only the lines you fill in.
# An empty value would override a working default, so leave unused lines commented.
# Comments must be on their own line: text after a value becomes part of the value.
# [secret] = server only: never in the web app, Git, chat or logs.

# --- Database (local Docker works without these; set for Supabase) ---
# DATABASE_URL=jdbc:postgresql://<host>:5432/postgres?sslmode=require
# DATABASE_USER=postgres
# [secret]
# DATABASE_PASSWORD=

# --- Sessions ---
# [secret] base64 of 32+ random bytes: openssl rand -base64 48
# APP_JWT_SECRET=
# true when served over HTTPS
# APP_COOKIE_SECURE=true
# APP_CORS_ORIGINS=https://weyvo.in

# --- Photo storage: local (default) or supabase ---
# APP_STORAGE_PROVIDER=supabase
# SUPABASE_URL=https://<project>.supabase.co
# [secret]
# SUPABASE_SERVICE_KEY=
# SUPABASE_BUCKET=trip-photos

# --- Email (Resend) ---
# [secret]
# RESEND_API_KEY=
# MAIL_FROM=Weyvo <hello@weyvo.in>

# --- Payments (Razorpay) ---
# public: the web app uses it too
# RAZORPAY_KEY_ID=rzp_test_xxx
# [secret]
# RAZORPAY_KEY_SECRET=
# [secret]
# RAZORPAY_WEBHOOK_SECRET=

# --- Monitoring (public values, fine in the web app) ---
# SENTRY_DSN=
# POSTHOG_KEY=

# --- Plan limits (application.yml defaults are low test values) ---
# PLAN_FREE_TOTAL_PHOTOS=300
# PLAN_FREE_UPLOADS_PER_HOUR=30

# --- Error reports (Sentry) ---
# Website (React project), public value, used at build time
# VITE_SENTRY_DSN=
# API (Spring Boot project)
# SENTRY_DSN=
